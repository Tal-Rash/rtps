[Unit]
Description=RTPS ALSN web app
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/rtps/web_alsn
Environment=WEB_HOST=0.0.0.0
Environment=WEB_PORT=8008
ExecStart=/usr/bin/python3 /opt/rtps/web_alsn/app.py
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
