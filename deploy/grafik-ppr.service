[Unit]
Description=RTPS График ППР web app
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/rtps/web_grafik_ppr
Environment=WEB_HOST=0.0.0.0
Environment=WEB_PORT=8000
ExecStart=/usr/bin/python3 /opt/rtps/web_grafik_ppr/app.py
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
