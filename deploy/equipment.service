[Unit]
Description=RTPS Оборудование и инструмент web app
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/rtps/web_equipment
Environment=WEB_HOST=0.0.0.0
Environment=WEB_PORT=8009
ExecStart=/usr/bin/python3 /opt/rtps/web_equipment/app.py
Restart=always
RestartSec=2
User=root

[Install]
WantedBy=multi-user.target
